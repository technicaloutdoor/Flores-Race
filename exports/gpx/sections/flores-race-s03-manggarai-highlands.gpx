<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Flores Race Planner (pipeline/export_gpx.py)" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>S03 Manggarai highlands</name>
    <desc>Section 03 of the Flores Race traverse: The roof of the west, and the deepest history on the island. 105.1 km, +3342 m / -2845 m, starts at km 266 of the course.</desc>
    <link href="https://github.com/technicaloutdoor/Flores-Race"><text>Flores Race Planner</text></link>
    <time>2026-09-05T06:27:57Z</time>
  </metadata>
  <wpt lat="-8.811670" lon="120.420020">
    <ele>49.0</ele>
    <name>Iteng</name>
    <desc>km 0.0 | kind: village | resupply: basic | water: unreliable | sleep: none -- Capital of Satar Mese kecamatan, on the south coast (a beach point is tagged at the village itself). Has a market (pasar Iteng), a Catholic parish, a health centre and schools -- the practical resupply between Todo and R</desc>
    <sym>Residence</sym>
    <type>anchor/village</type>
  </wpt>
  <wpt lat="-8.612700" lon="120.463000">
    <ele>1174.5</ele>
    <name>Ruteng</name>
    <desc>km 41.9 | kind: town | resupply: full | water: reliable | sleep: hotel -- Capital of Manggarai Regency, 1,168-1,188 m, cool highland town: hospital, market, banks, many hotels, served by Frans Sales Lega airport. Best full resupply of the whole west region.</desc>
    <sym>City (Medium)</sym>
    <type>anchor/town</type>
  </wpt>
  <wpt lat="-8.640600" lon="120.560300">
    <ele>1226.4</ele>
    <name>Ranamese</name>
    <desc>km 67.2 | kind: junction | resupply: minimal | water: unreliable | sleep: none -- Junction/rest stop by Ranamese crater lake in the Ruteng Nature Recreation Park, ~16 km from Ruteng on the road toward Manggarai Timur. A warung is reported at the lakeside car park.</desc>
    <sym>Waypoint</sym>
    <type>anchor/junction</type>
  </wpt>
  <wpt lat="-8.530820" lon="120.443500">
    <ele>559.6</ele>
    <name>Liang Bua</name>
    <desc>km 105.1 | kind: village | resupply: minimal | water: unreliable | sleep: none -- The village and limestone cave ~14 km NW of Ruteng where Homo floresiensis was found (2003). Small vendor stalls at the site; no lodging confirmed.</desc>
    <sym>Residence</sym>
    <type>anchor/village</type>
  </wpt>
  <wpt lat="-8.589440" lon="120.470830">
    <ele>1173.9</ele>
    <name>Golo Curu</name>
    <desc>[highlight] A hill above Ruteng town (Karot, Langke Rembong) with a Marian grotto (Gua Maria Golo Curu) and a panorama over the highland capital -- an easy add-on to a Ruteng stop.</desc>
    <sym>Scenic Area</sym>
    <type>poi/viewpoint</type>
  </wpt>
  <wpt lat="-8.530820" lon="120.443500">
    <ele>559.6</ele>
    <name>Liang Bua</name>
    <desc>[anchor] Limestone cave ~14 km NW of Ruteng where the remains of Homo floresiensis ("the hobbit") were excavated in 2003 -- the deep-time hook of the whole race.</desc>
    <sym>Tunnel</sym>
    <type>poi/cave</type>
  </wpt>
  <wpt lat="-8.651660" lon="120.448330">
    <ele>2356.8</ele>
    <name>Poco Mandasawu</name>
    <desc>[highlight, hike-a-bike] A lava dome of the Ranakah volcanic complex and the highest point on Flores at 2,370 m, south-central Manggarai; no confirmed historical eruption.</desc>
    <sym>Summit</sym>
    <type>poi/volcano</type>
  </wpt>
  <wpt lat="-8.637000" lon="120.530000">
    <ele>2273.8</ele>
    <name>Poco Ranaka</name>
    <desc>[highlight, hike-a-bike] Volcanic complex south-east of Ruteng, 2,350 m, with the 1987 lava dome Anak Ranakah; last eruption March 1991, a diffuse steam plume reported in 2011, no PVMBG alert elevation on record since.</desc>
    <sym>Summit</sym>
    <type>poi/volcano</type>
  </wpt>
  <wpt lat="-8.640600" lon="120.560300">
    <ele>1226.4</ele>
    <name>Ranamese lake</name>
    <desc>[highlight] A small (~5 ha), 21 m deep crater lake at 1,220 m in the Ruteng Nature Recreation Park, ~16 km from Ruteng, beside Golo Lusang and Poco Ranaka; a natural rest stop on the road to Manggarai Timur.</desc>
    <sym>Scenic Area</sym>
    <type>poi/crater-lake</type>
  </wpt>
  <wpt lat="-8.618070" lon="120.462420">
    <ele>1207.4</ele>
    <name>Ruteng Cathedral</name>
    <desc>[highlight, position approximate] The Catholic cathedral of the Diocese of Ruteng, consecrated 2002, seats 2,500; the visual centre of the Manggarai highland capital.</desc>
    <sym>Church</sym>
    <type>poi/religious</type>
  </wpt>
  <wpt lat="-8.609430" lon="120.462430">
    <ele>1161.5</ele>
    <name>Ruteng market</name>
    <desc>[resupply] The central market of Ruteng town: produce, dry goods, basic bike/moto parts -- the best full resupply point of the whole west region.</desc>
    <sym>Shopping Center</sym>
    <type>poi/market</type>
  </wpt>
  <wpt lat="-8.730920" lon="120.381590">
    <ele>464.5</ele>
    <name>Todo</name>
    <desc>[anchor] Former seat of the Manggarai kingdom, with the oldest mbaru niang (conical drum house) in the regency and a genealogy said to trace Manggarai's first king; a day-trip village, not set up for overnight stays.</desc>
    <sym>Museum</sym>
    <type>poi/traditional-village</type>
  </wpt>

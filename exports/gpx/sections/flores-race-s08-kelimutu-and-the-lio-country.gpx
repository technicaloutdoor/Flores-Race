<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Flores Race Planner (pipeline/export_gpx.py)" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>S08 Kelimutu and the Lio country</name>
    <desc>Section 08 of the Flores Race traverse: The one stop every rider is required to make. 149.4 km, +4704 m / -4765 m, starts at km 904 of the course.</desc>
    <link href="https://github.com/technicaloutdoor/Flores-Race"><text>Flores Race Planner</text></link>
    <time>2026-09-05T06:27:58Z</time>
  </metadata>
  <wpt lat="-8.838100" lon="121.656150">
    <ele>68.7</ele>
    <name>Ende</name>
    <desc>km 0.0 | kind: town | resupply: full | water: reliable | sleep: hotel -- Largest town of central Flores, capital of Ende Regency, on the south coast under Iya volcano; full resupply, hospital, airport, Sukarno's 1934-38 exile town. Natural Earth's populated-place point for Ende sits 2.81 km s</desc>
    <sym>City (Medium)</sym>
    <type>anchor/town</type>
  </wpt>
  <wpt lat="-8.716111" lon="121.759722">
    <ele>743.0</ele>
    <name>Detusoko</name>
    <desc>km 42.8 | kind: village | resupply: basic | water: reliable | sleep: homestay -- Highland district capital ~33 km/1,100 km north of Ende on the road to Moni; cool air, green rice terraces, a tourism village (Detusoko Barat) with homestays.</desc>
    <sym>Residence</sym>
    <type>anchor/village</type>
  </wpt>
  <wpt lat="-8.751000" lon="121.822000">
    <ele>1234.8</ele>
    <name>Moni</name>
    <desc>km 68.3 | kind: village | resupply: basic | water: reliable | sleep: guesthouse | position approximate -- Small highland hamlet at the foot of Kelimutu, ~50 km east of Ende; a dozen guesthouses and warungs, the usual overnight base for a dawn ascent to the crater lakes. An independent cross-check (Overture Maps place theme) </desc>
    <sym>Residence</sym>
    <type>anchor/village</type>
  </wpt>
  <wpt lat="-8.769000" lon="121.820000">
    <ele>1589.6</ele>
    <name>Kelimutu</name>
    <desc>km 78.4 | kind: checkpoint | resupply: none | water: none | sleep: none -- Kelimutu National Park entrance gate (~1,234 m) and summit car park (~1,522 m), a 20-minute paved walk from the three crater lakes; the mandatory dawn checkpoint of the race. Booth opens 05:00.</desc>
    <sym>Flag, Blue</sym>
    <type>anchor/checkpoint</type>
  </wpt>
  <wpt lat="-8.814444" lon="121.850000">
    <ele>492.0</ele>
    <name>Wolojita</name>
    <desc>km 97.6 | kind: village | resupply: minimal | water: unreliable | sleep: homestay -- District (kecamatan) centre and ikat-weaving village on the south Lio coast, between Jopu and Nggela.</desc>
    <sym>Residence</sym>
    <type>anchor/village</type>
  </wpt>
  <wpt lat="-8.843000" lon="121.848000">
    <ele>156.4</ele>
    <name>Nggela</name>
    <desc>km 105.0 | kind: checkpoint | resupply: minimal | water: unreliable | sleep: homestay | position approximate -- Lio ikat-weaving village on a coastal ridge (~180 m) 21 km east of Ende town, 1 km inland from the south coast; end anchor of the Central region, proposed cultural checkpoint per route-concept design rule 5.</desc>
    <sym>Flag, Blue</sym>
    <type>anchor/checkpoint</type>
  </wpt>
  <wpt lat="-8.795162" lon="122.018125">
    <ele>6.4</ele>
    <name>Koka</name>
    <desc>km 149.4 | kind: checkpoint | resupply: minimal | water: unreliable | sleep: none -- Twin-bay beach on the south coast, reached via an ~8 km side road off the Trans-Flores highway near Paga. No lodging found; day-stop / checkpoint only. Coordinates from a single beach-tourism source; DEM confirms a coast</desc>
    <sym>Flag, Blue</sym>
    <type>anchor/checkpoint</type>
  </wpt>
  <wpt lat="-8.716111" lon="121.759722">
    <ele>743.0</ele>
    <name>Detusoko Rice Terraces</name>
    <desc>[highlight] Green terraced rice fields around Detusoko village (~800 m), ~33 km north of Ende on the road to Moni; cool air and a working highland farming landscape.</desc>
    <sym>Scenic Area</sym>
    <type>poi/rice-terrace</type>
  </wpt>
  <wpt lat="-8.849170" lon="121.660560">
    <ele>13.0</ele>
    <name>H. Hasan Aroeboesman Airport</name>
    <desc>[resupply] Ende's airport (IATA ENE), ~2 km southeast of the town centre; scheduled flights to Kupang, Bali and other Flores towns, and the region's main air-evacuation point.</desc>
    <sym>Airport</sym>
    <type>poi/airport</type>
  </wpt>
  <wpt lat="-8.838100" lon="121.656150">
    <ele>68.7</ele>
    <name>Ende</name>
    <desc>[resupply] Capital of Ende Regency and the largest town of central Flores, on the south coast under Iya volcano; full resupply, hospital, airport, and the town where Sukarno was exiled 1934-38.</desc>
    <sym>Museum</sym>
    <type>poi/heritage</type>
  </wpt>
  <wpt lat="-8.794472" lon="121.857684">
    <ele>365.2</ele>
    <name>Jopu</name>
    <desc>[highlight] Lio ikat-weaving village in Wolowaru district, on the road between Moni and Wolojita/Nggela, in hilly interior country.</desc>
    <sym>Shopping Center</sym>
    <type>poi/weaving</type>
  </wpt>
  <wpt lat="-8.766700" lon="121.816700">
    <ele>1522.0</ele>
    <name>Kelimutu</name>
    <desc>[anchor, hike-a-bike] Three adjacent crater lakes (1,639 m) on a single volcanic summit, each a different and independently changing colour: Tiwu Ata Mbupu (blue), Tiwu Nua Muri Kooh Tai (green) and Tiwu Ata Polo (red/black).</desc>
    <sym>Scenic Area</sym>
    <type>poi/crater-lake</type>
  </wpt>
  <wpt lat="-8.795162" lon="122.018125">
    <ele>6.4</ele>
    <name>Koka Beach</name>
    <desc>[anchor] Twin coves of pale sand and turquoise water separated by a small headland, ~8 km off the highway near Paga; one of the most photographed beaches on Flores' south coast.</desc>
    <sym>Beach</sym>
    <type>poi/beach</type>
  </wpt>
  <wpt lat="-8.751000" lon="121.822000">
    <ele>1234.8</ele>
    <name>Moni</name>
    <desc>[resupply, position approximate] A small highland village at the foot of Kelimutu with guesthouses, warungs and hidden hot springs; the usual overnight stop before a dawn ascent to the crater lakes.</desc>
    <sym>Waypoint</sym>
    <type>poi/other</type>
  </wpt>
  <wpt lat="-8.843000" lon="121.848000">
    <ele>156.4</ele>
    <name>Nggela</name>
    <desc>[anchor, position approximate] A Lio ikat-weaving village on a coastal ridge (~180 m) 21 km east of Ende, reached by a single-track road through Jopu and Pora; sought-after ikat cloth with distinct Lio motifs.</desc>
    <sym>Shopping Center</sym>
    <type>poi/weaving</type>
  </wpt>
  <wpt lat="-8.846900" lon="121.662900">
    <ele>15.5</ele>
    <name>Bung Karno Contemplation Park</name>
    <desc>[highlight] A seafront park in Ende where Sukarno is said to have contemplated the five principles of Pancasila under a breadfruit tree during his 1934-38 exile; the current tree (planted 1980) has five branches.</desc>
    <sym>Museum</sym>
    <type>poi/heritage</type>
  </wpt>
  <wpt lat="-8.840767" lon="121.644439">
    <ele>19.5</ele>
    <name>Bung Karno's Exile House</name>
    <desc>[highlight] The house on Jalan Perwira, Ende, where Sukarno lived during his 1934-38 exile under the Dutch colonial government; a museum of his belongings since 1954.</desc>
    <sym>Museum</sym>
    <type>poi/heritage</type>
  </wpt>
  <wpt lat="-8.708500" lon="121.823300">
    <ele>1119.2</ele>
    <name>Wologai</name>
    <desc>[highlight, position approximate] An ~800-year-old Lio traditional village in Detusoko district (~1,000-1,045 m), ~37 km east of Ende; a circular arrangement of houses around a stone-terraced ceremonial centre.</desc>
    <sym>Museum</sym>
    <type>poi/traditional-village</type>
  </wpt>
  <wpt lat="-8.814444" lon="121.850000">
    <ele>492.0</ele>
    <name>Wolojita</name>
    <desc>[highlight] Ikat-weaving village and district centre on the south Lio coast, between Jopu and Nggela; part of the same weaving-village cluster with a shared weavers' community.</desc>
    <sym>Shopping Center</sym>
    <type>poi/weaving</type>
  </wpt>
  <wpt lat="-8.854208" lon="121.709486">
    <ele>20.4</ele>
    <name>Wolotopo</name>
    <desc>[highlight] A Lio traditional village built into a steep hillside on the south coast, ~12 km east of Ende via Wolowona market; households still practise ikat weaving and keep traditional ceremonial houses.</desc>
    <sym>Museum</sym>
    <type>poi/traditional-village</type>
  </wpt>

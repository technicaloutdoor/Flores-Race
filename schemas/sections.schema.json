{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sections.schema.json",
  "title": "Narrative sections (Array)",
  "description": "Ordered chapters of the course with story, theme, and highlights",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^sec-[0-9]{2}-[a-z0-9-]+$"
      },
      "order": {
        "type": "integer"
      },
      "title": {
        "type": "string"
      },
      "subtitle": {
        "type": "string"
      },
      "from_node": {
        "type": "string",
        "pattern": "^n-[a-z0-9-]+$"
      },
      "to_node": {
        "type": "string",
        "pattern": "^n-[a-z0-9-]+$"
      },
      "theme": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/theme"
        }
      },
      "story": {
        "type": "string",
        "description": "Markdown narrative for stakeholders"
      },
      "highlight_pois": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^p-[a-z0-9-]+$"
        }
      },
      "target_km": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        },
        "description": "[min, max]"
      },
      "hab_expected": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "scouting_priority": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "open_questions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "public": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "order",
      "title",
      "from_node",
      "to_node",
      "theme",
      "story",
      "highlight_pois",
      "target_km",
      "hab_expected",
      "scouting_priority",
      "open_questions"
    ],
    "additionalProperties": false
  }
}

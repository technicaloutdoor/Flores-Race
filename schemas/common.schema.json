{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common definitions for Flores Race Planner",
  "description": "Shared enumerations and definitions referenced by other schemas",
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": [
        "verified",
        "approximate",
        "unverified"
      ],
      "description": "Geolocation confidence level"
    },
    "status": {
      "type": "string",
      "enum": [
        "concept",
        "desk-checked",
        "scouted-go",
        "scouted-no-go",
        "needs-recheck",
        "confirmed"
      ],
      "description": "Segment status in the scouting workflow"
    },
    "geometry_source": {
      "type": "string",
      "enum": [
        "concept-sketch",
        "overture-route",
        "gpx-field",
        "manual-trace"
      ],
      "description": "How the geometry was derived"
    },
    "character": {
      "type": "string",
      "enum": [
        "paved",
        "gravel",
        "dirt",
        "singletrack",
        "hab",
        "mixed",
        "unknown"
      ],
      "description": "Dominant surface character"
    },
    "theme": {
      "type": "string",
      "enum": [
        "volcano",
        "highland",
        "coast",
        "culture",
        "forest",
        "savanna",
        "history"
      ],
      "description": "Section theme"
    },
    "ScoutingEntry": {
      "type": "object",
      "description": "Field verdict from a scouting trip",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD"
        },
        "team": {
          "type": "string",
          "description": "Initials or names of the team"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "go",
            "no-go",
            "partial"
          ]
        },
        "notes": {
          "type": "string"
        },
        "gpx": {
          "type": "string",
          "description": "Path under data/scouting/gpx/"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths or URLs"
        }
      },
      "required": [
        "date",
        "team",
        "verdict"
      ],
      "additionalProperties": false
    },
    "Stats": {
      "type": "object",
      "description": "Derived statistics for a segment or route",
      "properties": {
        "length_km": {
          "type": "number",
          "description": "Geodesic length"
        },
        "ascent_m": {
          "type": "number",
          "description": "Ascent from the DEM with smoothing"
        },
        "descent_m": {
          "type": "number",
          "description": "Descent from the DEM with smoothing"
        },
        "min_elev_m": {
          "type": "number",
          "description": "Minimum elevation"
        },
        "max_elev_m": {
          "type": "number",
          "description": "Maximum elevation"
        },
        "unpaved_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of unpaved surface"
        },
        "profile_ref": {
          "type": "string",
          "description": "Key in profiles.json"
        }
      },
      "additionalProperties": false
    }
  }
}
